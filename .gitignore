# Unity generated directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Unity build output
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
sysinfo.txt

# Addressables / test artifacts
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
InitTestScene*.unity

# Autogenerated solution and project files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db

# IDE
.vs/
.idea/
.history/
*.vsix
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Build artifacts
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
artifacts/
publish/
[Tt]est[Rr]esult*/

# Binaries — 플러그인은 Assets/Packages 안에 들어오므로 되살린다
*.dll
*.so
*.dylib
*.a
*.lib
*.pdb
!/[Aa]ssets/**/*.dll
!/[Aa]ssets/**/*.so
!/[Aa]ssets/**/*.dylib
!/[Aa]ssets/**/*.a
!/[Aa]ssets/**/*.lib
!/[Pp]ackages/**/*.dll
!/[Pp]ackages/**/*.so
!/[Pp]ackages/**/*.dylib
!/[Pp]ackages/**/*.a

# OS
.DS_Store
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
